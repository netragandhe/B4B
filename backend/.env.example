# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost
API_PREFIX=/api/v1

# Frontend URL (CORS allowed origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (XAMPP MySQL on Port 3307 or 3306)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3307/b4b_america"

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
