{
  "name": "b4b-america-platform",
  "version": "1.0.0",
  "private": true,
  "description": "B4B America Platform — Monorepo Root",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run --prefix frontend dev",
    "dev:backend": "npm run --prefix backend dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run --prefix frontend build",
    "build:backend": "npm run --prefix backend build",
    "lint:frontend": "npm run --prefix frontend lint",
    "prisma:generate": "npm run --prefix backend prisma:generate",
    "prisma:seed": "npm run --prefix backend prisma:seed"
  },
  "keywords": ["b4b", "america", "business-advisory", "saas"],
  "author": "B4B America"
}

